# emuctl web interface. See docs/web.md.
#
# Runs as its own account, emuctl-web, never root. It starts and stops guests
# through the polkit rule in examples/polkit/, and reads guest workdirs
# through group membership the admin grants (docs/web.md says which).
#
# Settings: /etc/emuctl/web.conf. Users: /etc/emuctl/web-users (root's; the
# daemon can read it, not change it). Certificate and key: /var/lib/emuctl-web.
# ProtectProc is left off on purpose: the daemon must see the guests' processes
# to tell a running guest from a stale state file.
[Unit]
Description=emuctl web interface
Documentation=https://github.com/kleinmatic/emuctl/blob/main/docs/web.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=emuctl-web
Group=emuctl-web
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/emuctl web serve
Restart=on-failure
RestartSec=5
# On stop the daemon waits for start and stop tasks it is running, so a
# guest's shutdown is never cut off half way. Only the daemon gets SIGTERM;
# its `emuctl stop` children are left to finish. Longer than the longest
# guest stop (emuctl-guest@'s TimeoutStopSec).
KillMode=mixed
TimeoutStopSec=480
StateDirectory=emuctl-web
StateDirectoryMode=0700
LogsDirectory=emuctl
LogsDirectoryMode=0755
# The daemon reads a great deal and writes only the two directories above.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# Bounds, so a flood of connections or a runaway cannot take the host with it.
LimitNOFILE=8192
TasksMax=256
MemoryMax=1G
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
